# Only source code and public documentation belong in this branch

# Ignore everything by default
/*

# But allow these
!/README.md
!/README_CN.md
!/.gitignore
!/.clangd
!/NuGet.config
!/CMakeLists.txt
!/build_release.bat
!/Task-Status.md
!/src/
!/include/

# Local application/application-material drafts and indexes
/.auto-index-mcp/
/Codex-OSS-Capability-Document.md
/src/flutter_gui/.idea/
/src/flutter_gui/vdtrace_gui.iml
/src/python_gui/

# Within src/, ignore build artifacts, __pycache__, etc.
/src/__pycache__/
/src/**/__pycache__/
/src/**/*.pyc
/src/**/*.pyo

# Windows junk
Thumbs.db
Desktop.ini
*.VC.db
*.VC.opendb
*.suo
*.user

# Local/runtime artifacts
bin/
obj/
*.ini
*.log
*.tmp
*.cache
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib
