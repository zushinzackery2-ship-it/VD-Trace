# Only source code and README belong in this branch

# Ignore everything by default
/*

# But allow these
!/README.md
!/.gitignore
!/src/
!/include/

# Within src/, ignore build artifacts, __pycache__, etc.
/src/__pycache__/
/src/**/__pycache__/
/src/**/*.pyc
/src/**/*.pyo

# Windows junk
Thumbs.db
Desktop.ini
*.VC.db
*.VC.opendb
*.suo
*.user
